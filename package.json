{
  "name": "mindgraphsim",
  "version": "0.8.0",
  "description": "Physics-based cognitive simulation for neurodivergent thought",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "check": "tsc --noEmit",
    "check:strict": "tsc --noEmit --project tsconfig.strict.json",
    "build": "vite build --config vite.site.config.ts",
    "build:engine": "vite build --config vite.engine.config.ts",
    "build:lib": "tsc && npm run build:engine",
    "build:all": "npm run build && npm run build:engine",
    "preview": "vite preview --config vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tests/generate_qa_report.cjs && node tests/generate_s3_model_comparison_report.cjs && node tests/test_regression.cjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "keywords": [
    "cognitive-simulation",
    "neurodivergent",
    "physics-simulation",
    "graph",
    "autism",
    "adhd",
    "mental-model"
  ],
  "author": "Tao Conrad",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
