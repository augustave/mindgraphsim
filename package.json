{
  "name": "mindgraphsim",
  "version": "0.7.0",
  "description": "Physics-based cognitive simulation for neurodivergent thought",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "vite build --config vite.site.config.ts",
    "build:lib": "tsc",
    "preview": "vite preview --config vite.site.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cognitive-simulation",
    "neurodivergent",
    "physics-simulation",
    "graph",
    "autism",
    "adhd",
    "mental-model"
  ],
  "author": "Tao Conrad",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}